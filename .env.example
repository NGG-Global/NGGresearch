# ---------------------------------------------------------------------------
# Layla Lavan Analytics — environment variables
#
# Copy to .env.local and fill in. Never commit real credentials.
# With none of these set the app runs in demo mode with sample Hebrew data.
# ---------------------------------------------------------------------------

# Mode: "demo" (sample data, no credentials) or "live" (real YouTube data).
# Omit to auto-detect: live when Supabase and Google are both configured.
APP_MODE=demo

# Public base URL of this deployment. Must exactly match the origin registered
# in Google Cloud, because the OAuth redirect URI is derived from it as
# <APP_BASE_URL>/api/auth/google/callback
APP_BASE_URL=http://localhost:3000

# --------------------------------------------------------------- Supabase ---
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Service role key. Server-side only — it bypasses Row Level Security and must
# never be exposed to the browser or committed.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------- Google OAuth ----
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 client
# (application type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------- App secrets --
# 32-byte key that encrypts Google tokens at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Secret used to sign the OAuth state cookie (CSRF protection).
# Generate: openssl rand -base64 32
APP_SESSION_SECRET=

# ------------------------------------------------------------- Scheduling ---
# Shared secret required by /api/cron/sync. Send it as
#   Authorization: Bearer <CRON_SECRET>   or   ?secret=<CRON_SECRET>
# Without it, scheduled sync returns 503 rather than running unauthenticated.
CRON_SECRET=

# ------------------------------------------------------------ AI insights ---
# Optional. Without a key, insights come from the deterministic rules engine.
ANTHROPIC_API_KEY=
# Model used for insight generation. Configurable so the product is not tied to
# a specific version.
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1200
# Set to false to force the rules engine even when a key is present.
AI_INSIGHTS_ENABLED=true
# Set to true to exercise the Claude path with demo data (off by default so
# opening the dashboard in demo mode costs nothing).
AI_INSIGHTS_IN_DEMO=false

# ------------------------------------------- YouTube Reporting API (reach) ---
# Thumbnail impressions and impressions CTR come only from Reporting API reach
# reports. Set to false to skip them entirely (they will show as unavailable).
YOUTUBE_REPORTING_ENABLED=true
# Report type used for reach. Verify the id against the reportTypes endpoint for
# your channel before changing it.
YOUTUBE_REPORTING_REACH_REPORT_TYPE=channel_reach_basic_a1

# ------------------------------------------------------------ Sync limits ----
# Bounds on API usage per sync run. Analytics costs one request per video, so
# these caps keep a run inside YouTube's quota.
SYNC_MAX_METADATA_VIDEOS=200
SYNC_MAX_ANALYTICS_VIDEOS=60
SYNC_MAX_DAILY_VIDEOS=30
